"""
Задача(Варіант 6):
Для виготовлення автозапчастин трьох видів А, В та С використовується токарне, 
фрезерувальне, зварювальне та шліфувальне обладнання. Витрати часу на обробку 
однієї автозапчастини для кожного з типів обладнання вказані в таблиці. У ній 
також вказано загальний фонд робочого часу кожного з типів обладнання, а також 
прибуток від реалізації одного готового виробу кожного виду. Потрібно скласти 
математичну модель задачі для визначення, яку кількість автозапчастин кожного 
виду слід виготовити, щоб прибуток від їх реалізації був максимальним.


Z =  10x + 14y + 12z -> max
Z =  -10x - 14y -12z -> min (use linprog)

x >= 0
y >= 0 
z >= 0 

2x + 4y + 5z <= 120
x + 8y + 6z <= 280
7x + 6y + 5z <= 240
4x + 6y + 7z <= 360
"""

# Дана версія рішення вирішує задане завдання з можливістю 
# отримати конкретне число кожного виду автозапчастин

from scipy.optimize import linprog

profit_func_coefficients = [-10, -14, -12]

A_ub = [
    [2, 4, 5],
    [1, 8, 6], 
    [7, 6, 5],
    [4, 6, 7]
]

b_ub = [120, 280, 240, 360]

x_bounds = (0, None)
y_bounds = (0, None)
z_bounds = (0, None)

# Solve the linear programming problem
result = linprog(profit_func_coefficients, 
                A_ub=A_ub, b_ub=b_ub,
                bounds=[x_bounds, y_bounds, z_bounds],
                method='highs')

print(-result.fun)
print(f"X = {result.x[0]}")
print(f"Y = {result.x[1]}")
print(f"Z = {result.x[2]}")