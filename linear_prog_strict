"""
Задача(Варіант 6):
Для виготовлення автозапчастин трьох видів А, В та С використовується токарне, 
фрезерувальне, зварювальне та шліфувальне обладнання. Витрати часу на обробку 
однієї автозапчастини для кожного з типів обладнання вказані в таблиці. У ній 
також вказано загальний фонд робочого часу кожного з типів обладнання, а також 
прибуток від реалізації одного готового виробу кожного виду. Потрібно скласти 
математичну модель задачі для визначення, яку кількість автозапчастин кожного 
виду слід виготовити, щоб прибуток від їх реалізації був максимальним.


Z =  10x + 14y + 12z -> max
Z =  -10x - 14y -12z -> min (use linprog)

x >= 0
y >= 0 
z >= 0 

2x + 4y + 5z <= 120
x + 8y + 6z <= 280
7x + 6y + 5z <= 240
4x + 6y + 7z <= 360
"""

# Дана версія рішення вирішує задане завдання з на основі прикладу, 
# який нам показав викладач на лекції. В мому випадку він не цілком доцільний
# оскільки даний код не враховує можливість підрахунку кількості автозапчастин 
# в точній кількості. Тобто в підтрахунку можуть бути присутні числа після коми,
# а потрібна точна кількість виробів. Тому крім цього коду є ще інший
# в файлі linear_prog_strict, який цю погрішність враховує

import numpy as np
from scipy.optimize import milp, LinearConstraint, Bounds

# milp мінімізує так саме як і в linprog
profit_func_coefficients = [-10, -14, -12]

A_ub = np.array([
    [2, 4, 5],
    [1, 8, 6],
    [7, 6, 5],
    [4, 6, 7]
])

b_ub = [120, 280, 240, 360]

# Задаємо обмеження типу <= (від -inf до відповідного елемента b_ub)
constraints = LinearConstraint(A_ub, -np.inf, b_ub)

# Межі для змінних: x >= 0, y >= 0, z >= 0
bounds = Bounds(lb=[0, 0, 0], ub=[np.inf, np.inf, np.inf])

# Головний параметр для цілих чисел. 
# 1 означає, що змінна має бути цілою (integer).
integrality = [1, 1, 1]

# Розв'язуємо задачу за допомогою алгоритму MILP
result = milp(c=profit_func_coefficients, 
              integrality=integrality, 
              constraints=constraints, 
              bounds=bounds)

# Виводимо результати
print(f"Максимальний прибуток: {-result.fun}")
print(f"X = {int(result.x[0])}")
print(f"Y = {int(result.x[1])}")
print(f"Z = {int(result.x[2])}")